PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/eduverse

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# AI APIs
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Configuration (IMPORTANT for email verification)
# To enable real email verification in production, configure SMTP settings:
# For Gmail:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to Google Account > Security > App Passwords
# 3. Generate an App Password for "Mail"
# 4. Use the App Password as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=your_email@gmail.com

# Alternative SMTP providers:
# SendGrid: smtp.sendgrid.net, port 587
# Mailgun: smtp.mailgun.org, port 587
# AWS SES: email-smtp.us-east-1.amazonaws.com, port 587

# NOTE: In development mode (when SMTP credentials are not configured),
# the system will show a development code in the UI instead of sending emails.
# This is intentional for testing purposes. In production, configure SMTP to send real emails.

# Frontend URLs - IMPORTANT: Update these with your production URLs
# For development (localhost):
STUDENT_FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
INSTRUCTOR_FRONTEND_URL=http://localhost:3002

# For production (Vercel deployments):
# STUDENT_FRONTEND_URL=https://smart-learning-system-6ndj-woad.vercel.app
# ADMIN_FRONTEND_URL=https://your-admin-frontend.vercel.app
# INSTRUCTOR_FRONTEND_URL=https://your-instructor-frontend.vercel.app
